# These three are NOT secret — they're the same IDs already visible in
# your live index.html / js/firebase-config.js — so it's fine for them
# to sit in this repo. Copy this file to ".env" if you ever need to
# override them (usually you won't).
EMAILJS_SERVICE_ID=service_4xpjztg
EMAILJS_TEMPLATE_ID=template_9hxgir7
EMAILJS_PUBLIC_KEY=Wvfl_ifH3R6tzLn26

# The Private Key is NOT set here, and never should be — this repo is
# public. Instead, set it once with:
#   firebase functions:secrets:set EMAILJS_PRIVATE_KEY
# Firebase stores it in Google Cloud Secret Manager and injects it into
# the Cloud Function at runtime. See functions/index.js for how it's used.
